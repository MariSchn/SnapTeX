# OpenAI-compatible API endpoint.
# Ollama: http://127.0.0.1:11434/v1
API_URL="<INSERT YOUR API URL HERE>"

# API key for the endpoint. Ollama ignores it, but it has to be set.
API_KEY="<INSERT YOUR API KEY HERE>"

# Model to use. Ollama: glm-ocr:q8_0
MODEL_NAME="<INSERT YOUR MODEL NAME HERE>"

# Comma separated list of hotkeys, e.g. ctrl+alt+l,ctrl+alt+k
SHORTCUTS="<INSERT YOUR SHORTCUTS HERE>"

# Upper bound on the reply. No equation in the benchmark needs more than ~90.
MAX_TOKENS="256"
